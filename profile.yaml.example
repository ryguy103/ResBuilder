# =============================================================================
# MASTER PROFESSIONAL PROFILE
# =============================================================================
# This file contains all your professional details. The AI uses this as a
# comprehensive source when tailoring resumes and cover letters.
#
# GETTING STARTED:
#   1. Copy this file to profile.yaml:  cp profile.yaml.example profile.yaml
#   2. Replace the placeholder data with your own information
#   3. Or skip this and use the web UI at http://localhost:8000/profile
#
# TIP: The more detail you include, the better the AI can tailor your
# applications. Add EVERY job, skill, and achievement you can think of.
# =============================================================================

personal:
  name: Jane Smith
  location: Austin, TX
  phone: "(555) 123-4567"
  email: jane.smith@example.com
  linkedin: linkedin.com/in/janesmith
  linkedin_url: https://www.linkedin.com/in/janesmith/
  website: https://janesmith.dev

  # Different summary variations for different role types.
  # The AI will pick the most relevant one based on the job description.
  summaries:
    default: >
      Full-stack engineer with 7+ years of experience building scalable web
      applications and leading cross-functional teams. Passionate about clean
      architecture, developer experience, and shipping products that users love.
      Seeking a senior engineering role at a mission-driven company.

    automation_focused: >
      Platform engineer with deep experience in CI/CD pipelines, infrastructure
      automation, and developer tooling. Built internal platforms serving 200+
      engineers, reducing deployment times by 80% and incident response by 60%.

    ai_focused: >
      Software engineer with a focus on applied AI/ML, building intelligent
      features powered by large language models. Experience integrating LLM APIs,
      designing prompt pipelines, and shipping AI-powered products to production.

    support_focused: >
      Technical leader experienced in building developer tools and support
      systems. Combines strong engineering skills with empathy for end users,
      having built self-service platforms that reduced support tickets by 45%.

experience:
  - company: Acme Corp
    location: Austin, TX (Hybrid)
    roles:
      - title: Senior Software Engineer
        dates: Mar 2022 – Present
        highlights:
          - Led migration of monolithic Rails app to microservices architecture, reducing deploy times from 45 min to 5 min
          - Designed and built real-time notification system handling 2M+ events/day using Kafka and WebSockets
          - Mentored 3 junior engineers through structured pairing and code review, all promoted within 12 months
          - Reduced P95 API latency by 60% by implementing Redis caching layer and query optimization
          - Drove adoption of TypeScript across frontend codebase, reducing production bugs by 35%

  - company: StartupXYZ
    location: San Francisco, CA (Remote)
    roles:
      - title: Software Engineer II
        dates: Jun 2019 – Feb 2022
        highlights:
          - Built customer-facing analytics dashboard from scratch using React, D3.js, and PostgreSQL
          - Implemented OAuth 2.0 / SAML SSO integration supporting 50+ enterprise customers
          - Created automated data pipeline processing 10GB+ daily using Airflow and Python
          - Contributed to open-source SDK used by 5,000+ developers (github.com/example/sdk)

      - title: Software Engineer I
        dates: Jan 2018 – Jun 2019
        highlights:
          - Developed RESTful APIs serving 100K+ daily active users using Python/Flask
          - Built internal admin tool that reduced customer onboarding time from 2 days to 2 hours
          - Wrote comprehensive test suite achieving 92% code coverage across core services

  - company: TechConsulting Inc.
    location: Portland, OR
    roles:
      - title: Junior Developer
        dates: Jun 2016 – Dec 2017
        highlights:
          - Built responsive web applications for 8+ clients using React and Node.js
          - Implemented CI/CD pipelines using Jenkins and Docker, reducing release cycles from monthly to weekly
          - Created reusable component library adopted across 5 client projects

